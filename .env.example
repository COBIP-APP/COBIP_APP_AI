# =========================
# LLM Provider
# =========================
LLM_PROVIDER=ollama

# Docker Compose 내부에서는 Ollama 서비스명 사용
OLLAMA_BASE_URL=http://ollama:11434/v1

# FastAPI만 docker run으로 실행하고 Ollama가 호스트에서 실행 중이면:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

OLLAMA_MODEL=qwen2.5-coder:1.5b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# =========================
# RAG / Qdrant / Embedding
# =========================
# 로컬 기본: RAG/cache OFF. EC2 운영은 docker-compose.deploy.yml + docker-compose.rag.yml
# 이 조합이 아래 cache ON·19차 skeleton 값을 ai-server environment 로 주입한다.
# (compose environment > .env > app/core/config.py 기본값)
RAG_ENABLED=false
RAG_TOP_K=3
FEATURE_TEMPLATE_RAG_TOP_K=3
FEATURE_TEMPLATE_RAG_CONTENT_MAX_CHARS=1000
# 로컬 기본 OFF. EC2 운영은 docker-compose.rag.yml 에서 true 로 주입
EMBEDDING_WARMUP_ENABLED=false
EMBEDDING_WARMUP_TEXT=Spring Boot 로그인 기능템플릿 RAG warm up
RAG_RETRIEVAL_CACHE_ENABLED=false
RAG_RETRIEVAL_CACHE_TTL_SECONDS=3600
FEATURE_TEMPLATE_CACHE_ENABLED=false
FEATURE_TEMPLATE_CACHE_TTL_SECONDS=3600
FEATURE_TEMPLATE_FAST_SKELETON_ENABLED=false
FEATURE_TEMPLATE_ULTRA_FAST_SKELETON_ENABLED=false
FEATURE_TEMPLATE_SKELETON_RAG_TOP_K=2
FEATURE_TEMPLATE_SKELETON_RAG_CONTENT_MAX_CHARS=300
FEATURE_TEMPLATE_SKELETON_MAX_TOKENS=800
FEATURE_TEMPLATE_LLM_FULL_FIRST_ENABLED=true
FEATURE_TEMPLATE_INSTANT_SKELETON_ENABLED=true
FEATURE_TEMPLATE_INITIAL_LLM_ENHANCEMENT_ENABLED=false
FEATURE_TEMPLATE_INITIAL_LLM_TIMEOUT_SECONDS=8
FEATURE_TEMPLATE_CACHE_INSTANT_SKELETON_ENABLED=true

# Compose 내부 기본
QDRANT_URL=http://qdrant:6333
# FastAPI만 호스트에서 docker run 할 때 Qdrant가 호스트에 있으면 예:
# QDRANT_URL=http://host.docker.internal:6333

QDRANT_COLLECTION=cobip_knowledge
EMBEDDING_MODEL=BAAI/bge-m3

# =========================
# App
# =========================
APP_NAME=COBIP AI Server
APP_ENV=local
DEBUG=true
API_PREFIX=/ai

# =========================
# Infrastructure
# =========================
# Compose 내부 Redis (운영 rag.yml 에서 cache ON 시 동일 URL 사용)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30
